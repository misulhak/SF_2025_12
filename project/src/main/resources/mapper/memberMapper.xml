<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.zerock.mapper.MemberMapper">

    <resultMap id="memberMap" type="org.zerock.dto.MemberDTO">
        <id property="userid" column="userid"/>
        <result property="num" column="num"/>
        <result property="name" column="name"/>
        <result property="pwd" column="pwd"/>
        <result property="email" column="email"/>
        <result property="phone" column="phone"/>
        <result property="admin" column="admin"/>
        <collection property="roleList" ofType="string">
            <result column="rolename"/>
        </collection>
    </resultMap>

    <sql id="searchCondition">
        <if test="keyword != null and keyword != ''">
            <trim prefix="AND (" suffix=")" prefixOverrides="OR">
                <if test="types != null">
                    <foreach collection="types" item="type">
                        <choose>
                            <when test='type == "u"'>
                                OR userid LIKE CONCAT('%', #{keyword}, '%')
                            </when>
                            <when test='type == "e"'>
                                OR email LIKE CONCAT('%', #{keyword}, '%')
                            </when>
                            <when test='type == "n"'>
                                OR name LIKE CONCAT('%', #{keyword}, '%')
                            </when>
                            <when test='type == "p"'>
                                OR phone LIKE CONCAT('%', #{keyword}, '%')
                            </when>
                        </choose>
                    </foreach>
                </if>
            </trim>
        </if>
    </sql>

    <insert id="insert">
        INSERT INTO tmember (name, userid, pwd, email, phone, admin)
        VALUES (#{name}, #{userid}, #{pwd}, #{email}, #{phone}, #{admin})
    </insert>

    <insert id="insertRole">
        INSERT INTO tmember_roles (userid, rolename)
        VALUES (#{userid}, #{rolename})
    </insert>

    <select id="selectOne" resultMap="memberMap">
        SELECT m.*, r.rolename
        FROM tmember m 
        LEFT JOIN tmember_roles r ON m.userid = r.userid
        WHERE m.userid = #{userid}
    </select>

    <update id="update">
        UPDATE tmember SET 
            name = #{name}, 
            email = #{email}, 
            phone = #{phone}, 
            admin = #{admin}
        WHERE userid = #{userid}
    </update>

    <select id="listSearch" resultType="org.zerock.dto.MemberDTO">
        SELECT num, name, userid, email, phone, admin
        FROM tmember
        <where>
            <include refid="searchCondition"></include>
        </where>
        ORDER BY 
            admin DESC,   -- 1순위: 관리자(1)가 일반유저(0)보다 먼저 나옴
            num DESC      -- 2순위: 그 안에서 번호가 큰 순서대로 나옴
        LIMIT #{skip}, #{count}
    </select>

    <select id="listCountSearch" resultType="int">
        SELECT COUNT(userid)
        FROM tmember
        <where>
            <include refid="searchCondition"></include>
        </where>
    </select>

</mapper>